{
  "productName": "Stotl",
  "version": "0.1.0",
  "identifier": "com.stotl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "TAURI_BUILD=1 npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Stotl",
        "width": 420,
        "height": 900,
        "resizable": true,
        "minWidth": 375,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: http:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https:; img-src 'self' data: blob: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    }
  }
}
